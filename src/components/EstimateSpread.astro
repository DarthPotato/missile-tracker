---
// Every source's stock-left figure for one missile, plotted on one time axis.
// Static SVG rendered at build time: no JavaScript needed to read it.
import type { Headline } from "../lib/model";
import { WAR_START, CEASEFIRE } from "../lib/model";
import { spreadPoints, recentSpread, type SpreadPoint } from "../lib/spread";
import { getDataset } from "../lib/data";
import { BUILD_DATE } from "../lib/scenario";
import { fmt, formatDate, formatRange } from "../lib/format";
import { CONFIDENCE_LABEL } from "../lib/describe";
import type { Munition } from "../lib/schema";

interface Props {
  munition: Munition;
  headline: Headline;
}
const { munition: m, headline: h } = Astro.props;
const points = spreadPoints(getDataset().reports, m.id, h, m.deliveriesPerYear.value);
const spread = recentSpread(points);

// Layout (viewBox units; the SVG scales to its container).
const W = 760;
const H = 340;
const pad = { top: 24, right: 20, bottom: 36, left: 56 };
const iw = W - pad.left - pad.right;
const ih = H - pad.top - pad.bottom;

const DAY = 86_400_000;
const t = (iso: string) => Date.parse(`${iso}T00:00:00Z`);
const newest = points.reduce((a, p) => (p.asOf > a ? p.asOf : a), h.asOf);
const x0 = t(WAR_START);
// Run the axis to today, so a long gap since the last estimate is visible.
const today = BUILD_DATE > newest ? BUILD_DATE : newest;
const x1 = Math.max(t(today) + 10 * DAY, x0 + 120 * DAY);
const yMax = Math.max(h.prewar, ...points.map((p) => p.remaining.high)) * 1.08;
const step = niceStep(yMax / 4);

function niceStep(raw: number): number {
  const mag = 10 ** Math.floor(Math.log10(raw));
  const n = raw / mag;
  return (n <= 1 ? 1 : n <= 2 ? 2 : n <= 2.5 ? 2.5 : n <= 5 ? 5 : 10) * mag;
}
const X = (iso: string) => pad.left + ((t(iso) - x0) / (x1 - x0)) * iw;
const Y = (v: number) => pad.top + ih - (v / yMax) * ih;

const yTicks: number[] = [];
for (let v = 0; v <= yMax; v += step) yTicks.push(v);

const xTicks: { x: number; label: string }[] = [];
{
  const d = new Date(x0);
  d.setUTCDate(1);
  d.setUTCMonth(d.getUTCMonth() + 1);
  const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  const months = Math.round((x1 - x0) / (30 * DAY));
  const every = months > 9 ? 2 : 1;
  for (let i = 0; d.getTime() <= x1; i++, d.setUTCMonth(d.getUTCMonth() + 1)) {
    if (i % every) continue;
    xTicks.push({ x: X(d.toISOString().slice(0, 10)), label: MONTHS[d.getUTCMonth()] });
  }
}

// Points on the same date sit side by side instead of on top of each other.
const placed = points.map((p, i) => {
  const same = points.filter((q) => q.asOf === p.asOf);
  const k = same.indexOf(p);
  return { p, n: i + 1, x: X(p.asOf) + (k - (same.length - 1) / 2) * 12 };
});

function marker(p: SpreadPoint): number {
  // One-sided figures sit at their stated bound.
  if (p.qualifier === "at-most") return p.remaining.high;
  if (p.qualifier === "at-least") return p.remaining.low;
  return (p.remaining.low + p.remaining.high) / 2;
}

function figure(p: SpreadPoint): string {
  return formatRange(p.remaining, p.qualifier);
}

function describe(p: SpreadPoint): string {
  const who = p.attribution ? `${p.attribution}, via ${p.outlet}` : p.outlet;
  const how =
    p.kind === "converted"
      ? ` (converted from a share used, on the ~${fmt(p.baseline!.value)} prewar figure from ${p.baseline!.outlet})`
      : p.kind === "derived"
        ? " (prewar minus used, same document)"
        : "";
  return `${figure(p)} left as of ${formatDate(p.asOf)}: ${who}, ${CONFIDENCE_LABEL[p.confidence].toLowerCase()}${how}`;
}
const caption = spread
  ? `${m.name}: ${points.length} stock figures from ${new Set(points.map((p) => p.outlet)).size} outlets. Estimates dated since ${formatDate(spread.since)} range from ${fmt(Math.round(spread.low))} to ${fmt(Math.round(spread.high))} left, against about ${fmt(h.prewar)} before the war.`
  : `${m.name}: no stock figures yet.`;
---

<figure class="spread">
  {spread && spread.n > 1 && (
    <p class="spread-summary">
      Recent estimates put {m.name} between{" "}
      <strong>
        {fmt(Math.round(spread.low))} and {fmt(Math.round(spread.high))}
      </strong>{" "}
      left{" "}
      <span class="muted">
        ({spread.n} sources since {formatDate(spread.since)})
      </span>
      .
    </p>
  )}
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={`spread-${m.id}-cap`}>
    <g class="grid">
      {yTicks.map((v) => (
        <g>
          <line x1={pad.left} x2={W - pad.right} y1={Y(v)} y2={Y(v)} />
          <text x={pad.left - 8} y={Y(v)} dy="0.35em" text-anchor="end">
            {fmt(v)}
          </text>
        </g>
      ))}
      {xTicks.map((tk) => (
        <text x={tk.x} y={H - pad.bottom + 20} text-anchor="middle">
          {tk.label}
        </text>
      ))}
    </g>

    <g class="ref">
      <line x1={pad.left} x2={W - pad.right} y1={Y(h.prewar)} y2={Y(h.prewar)} class="prewar" />
      <text x={W - pad.right} y={Y(h.prewar) - 6} text-anchor="end">
        ~{fmt(h.prewar)} before the war
      </text>
      <line x1={X(CEASEFIRE)} x2={X(CEASEFIRE)} y1={pad.top} y2={pad.top + ih} class="event" />
      <text x={X(CEASEFIRE) + 4} y={pad.top + 10}>
        Ceasefire
      </text>
      <line x1={X(today)} x2={X(today)} y1={pad.top} y2={pad.top + ih} class="event" />
      <text x={X(today) - 4} y={pad.top + ih - 6} text-anchor="end">
        Today
      </text>
    </g>

    {placed.map(({ p, n, x }) => {
      const y = Y(marker(p));
      const span = p.remaining.high - p.remaining.low;
      const cls = `pt ${p.confidence} ${p.kind}${p.headline ? " head" : ""}`;
      return (
        <a href={p.url} rel="noopener" class={cls} aria-label={`${n}. ${describe(p)}`}>
          <title>{`${n}. ${describe(p)}`}</title>
          {span > 0 && p.qualifier !== "at-most" && p.qualifier !== "at-least" && (
            <line class="bar" x1={x} x2={x} y1={Y(p.remaining.low)} y2={Y(p.remaining.high)} />
          )}
          {p.qualifier === "at-most" && <path class="arrow" d={`M${x},${y + 4} v16 m-4,-5 l4,5 l4,-5`} />}
          {p.qualifier === "at-least" && <path class="arrow" d={`M${x},${y - 4} v-16 m-4,5 l4,-5 l4,5`} />}
          <circle cx={x} cy={y} r={p.headline ? 6 : 4.5} />
          <text
            x={x}
            y={p.qualifier === "at-least" ? y + 20 : Math.min(y, Y(p.remaining.high)) - 9}
            text-anchor="middle"
            class="num"
          >
            {n}
          </text>
        </a>
      );
    })}
  </svg>
  <figcaption id={`spread-${m.id}-cap`} class="sr-only">
    {caption}
  </figcaption>

  <ul class="spread-key small" aria-hidden="true">
    <li>
      <span class="k head"></span> Headline figure
    </li>
    <li>
      <span class="k official"></span> Official
    </li>
    <li>
      <span class="k reported"></span> Reported
    </li>
    <li>
      <span class="k estimate"></span> Estimate
    </li>
    <li>
      <span class="k converted"></span> Converted from a share used
    </li>
    <li>
      <span class="k arrow">↓</span> "At most" / ↑ "at least"
    </li>
  </ul>

  <ol class="spread-list small">
    {placed.map(({ p }) => (
      <li class={p.headline ? "head" : undefined}>
        <strong>{figure(p)}</strong> <span class="muted">· {formatDate(p.asOf)} ·</span>{" "}
        <a href={p.url} rel="noopener">
          {p.attribution ? `${p.attribution.split(",")[0]} via ${p.outlet}` : p.outlet}
        </a>
        {p.headline && <span class="pill">headline</span>}
        {p.kind === "converted" && (
          <span class="muted">
            {" "}
            · converted from a share used, on the ~{fmt(p.baseline!.value)} prewar figure from {p.baseline!.outlet}
          </span>
        )}
        {p.kind === "derived" && <span class="muted"> · prewar minus used</span>}
      </li>
    ))}
  </ol>
</figure>

<style>
  .spread {
    margin: 0;
  }
  .spread-summary {
    font-size: 17px;
    margin: 0 0 12px;
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .grid line {
    stroke: var(--grid);
  }
  .grid text,
  .ref text {
    fill: var(--ink-3);
    font: 12px var(--mono);
  }
  .prewar {
    stroke: var(--axis);
    stroke-dasharray: 5 4;
  }
  .event {
    stroke: var(--axis);
    stroke-dasharray: 2 3;
  }
  .pt .bar {
    stroke: var(--ink-3);
    stroke-width: 4;
    stroke-linecap: round;
    opacity: 0.55;
  }
  .pt.converted .bar {
    stroke-dasharray: 2 4;
    opacity: 0.9;
  }
  .pt .arrow {
    stroke: var(--ink-3);
    stroke-width: 1.75;
    fill: none;
  }
  .pt circle {
    stroke-width: 2;
  }
  .pt.official circle {
    fill: var(--ink);
    stroke: var(--ink);
  }
  .pt.reported circle {
    fill: var(--ink-3);
    stroke: var(--ink-3);
  }
  .pt.estimate circle {
    fill: var(--surface);
    stroke: var(--ink-2);
  }
  .pt.converted circle {
    fill: var(--surface);
    stroke-dasharray: 3 2;
  }
  .pt.head circle {
    stroke: var(--series-1);
    stroke-width: 3;
  }
  .pt.head .bar {
    stroke: var(--series-1);
    opacity: 0.8;
  }
  .pt .num {
    fill: var(--ink-2);
    font: 600 11px var(--mono);
  }
  .pt:hover circle,
  .pt:focus-visible circle {
    stroke: var(--link);
    stroke-width: 3;
  }
  .pt:focus-visible {
    outline: none;
  }
  .spread-key {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
    color: var(--ink-2);
  }
  .k {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    vertical-align: -1px;
    margin-right: 2px;
    border: 2px solid var(--ink-2);
  }
  .k.head {
    border-color: var(--series-1);
    border-width: 3px;
  }
  .k.official {
    background: var(--ink);
    border-color: var(--ink);
  }
  .k.reported {
    background: var(--ink-3);
    border-color: var(--ink-3);
  }
  .k.converted {
    border-style: dashed;
  }
  .k.arrow {
    border: 0;
    width: auto;
    height: auto;
    color: var(--ink-3);
  }
  .spread-list {
    margin: 14px 0 0;
    padding-left: 22px;
    display: grid;
    gap: 4px;
  }
  .spread-list li.head strong {
    color: var(--series-1);
  }
  .pill {
    margin-left: 6px;
    font: 600 11px var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--series-1);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
