---
import type { Status } from "../lib/status";
interface Props {
  status: Status;
}
const { status } = Astro.props;
---

<span class="chip" data-level={status.level}>
  {status.level === "critical" ? (
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
      <path d="M8 1.5l7 12.5H1z" fill="currentColor" />
      <path d="M8 6v3.6M8 11.4v.1" stroke="var(--surface)" stroke-width="1.7" stroke-linecap="round" />
    </svg>
  ) : status.level === "good" ? (
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
      <circle cx="8" cy="8" r="7" fill="currentColor" />
      <path
        d="M4.8 8.2l2.1 2.1 4.3-4.4"
        stroke="var(--surface)"
        stroke-width="1.7"
        fill="none"
        stroke-linecap="round"
      />
    </svg>
  ) : (
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
      <circle cx="8" cy="8" r="7" fill="currentColor" />
      <path d="M8 4.5v4M8 11v.1" stroke="var(--surface)" stroke-width="1.7" stroke-linecap="round" />
    </svg>
  )}
  <span>{status.label}</span>
</span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }
  .chip svg {
    flex: none;
  }
  .chip[data-level="critical"] svg {
    color: var(--critical);
  }
  .chip[data-level="serious"] svg {
    color: var(--serious);
  }
  .chip[data-level="warning"] svg {
    color: var(--warning);
  }
  .chip[data-level="good"] svg {
    color: var(--good);
  }
</style>
