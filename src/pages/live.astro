---
import Base from "../layouts/Base.astro";
import LiveChart from "../components/LiveChart.astro";
import { getLive } from "../lib/data";
import {
  IRAN_THEATERS,
  RELIABILITY_LABEL,
  THEATER_LABEL,
  THREAT_LABEL,
  daysAgo,
  eventCount,
  filterEvents,
  reliability,
  totals,
  type CountRange,
  type LiveEvent,
} from "../lib/live";
import { BUILD_DATE } from "../lib/scenario";
import { fmt, formatDate } from "../lib/format";
import { href } from "../lib/site";

const live = getLive();
const today = BUILD_DATE;
const since30 = daysAgo(today, 29);
const groups = [
  {
    id: "iran",
    title: "Iran war theaters",
    note: "Persian Gulf, Israel and the Red Sea. These intercepts draw on the same U.S.-made interceptors the stockpile figures track.",
    events: filterEvents(live.events, daysAgo(today, 59), IRAN_THEATERS),
  },
  {
    id: "ukraine",
    title: "Ukraine",
    note: "Ukraine's Air Force posts a tally every morning. Most drones are downed by guns, jammers and interceptor drones, not by U.S. missiles.",
    events: filterEvents(live.events, daysAgo(today, 59), ["ukraine"]),
  },
];
const latest = live.events.slice(0, 40);

const range = (c?: CountRange) =>
  !c ? "?" : Math.round(c.low) === Math.round(c.high) ? fmt(c.low) : `${fmt(c.low)}–${fmt(c.high)}`;

function headlineFor(e: LiveEvent): string {
  const hit = eventCount(e, "intercepted");
  const fired = eventCount(e, "launched");
  const what = THREAT_LABEL[e.threat];
  if (hit && fired) return `${range(hit)} of ${range(fired)} ${what} shot down`;
  if (hit) return `${range(hit)} ${what} shot down`;
  return `${range(fired)} ${what} launched`;
}
---

<Base
  title="Live intercept log"
  description="Drones and missiles reported shot down, from Telegram channels and news, updated several times a day. Unverified."
>
  <header class="lhead">
    <div class="label warn">Unverified · updated every 6 hours</div>
    <h1>Live intercept log</h1>
    <p class="lede">
      Drones and missiles reported shot down, read automatically from public Telegram channels and news headlines. It's
      current, but it isn't checked by a person, and early counts are often wrong. None of it feeds the stockpile
      estimates.
    </p>
    <p class="small muted">
      {live.updated ? (
        <>
          Last read {formatDate(live.updated.slice(0, 10))}, {live.updated.slice(11, 16)} UTC.
        </>
      ) : (
        "Not run yet."
      )}{" "}
      <a href={href("/methodology/#live")}>How this works</a>
    </p>
  </header>

  {groups.map((g) => {
    const e30 = filterEvents(g.events, since30);
    const t30 = totals(e30);
    const anyLaunched = e30.some((e) => eventCount(e, "launched"));
    return (
      <section id={g.id}>
        <div class="section-head">
          <h2>{g.title}</h2>
        </div>
        <p class="muted small">{g.note}</p>
        <div class="tiles">
          <div class="card tile">
            <div class="tile-label">Reported shot down, last 30 days</div>
            <div class="tile-value">{range(t30.intercepted)}</div>
          </div>
          <div class="card tile">
            <div class="tile-label">Reported launched, last 30 days</div>
            <div class="tile-value">{anyLaunched ? range(t30.launched) : "–"}</div>
            <div class="tile-note">where the source gives a number</div>
          </div>
          <div class="card tile">
            <div class="tile-label">Events logged</div>
            <div class="tile-value">{fmt(t30.events)}</div>
          </div>
        </div>
        {g.events.length ? (
          <LiveChart events={g.events} today={today} label={g.title} />
        ) : (
          <p class="empty muted small">Nothing logged in the last 60 days.</p>
        )}
      </section>
    );
  })}

  <section id="log">
    <div class="section-head">
      <h2>Latest reports</h2>
    </div>
    {latest.length === 0 && <p class="muted">The feed hasn't logged anything yet.</p>}
    <ol class="events">
      {latest.map((e) => {
        const rel = reliability(e);
        return (
          <li class="card ev">
            <div class="ev-top">
              <span class="small muted">
                {formatDate(e.date)} · {THEATER_LABEL[e.theater]} · {e.defender}
              </span>
              <span class={`rel ${rel}`}>{RELIABILITY_LABEL[rel]}</span>
            </div>
            <div class="ev-main">
              <strong>{headlineFor(e)}</strong>
              {e.systems.length > 0 && <span class="muted small"> · {e.systems.join(", ")}</span>}
              {e.usInvolved && <span class="us small">U.S. involved</span>}
            </div>
            <details>
              <summary class="small">
                {e.sources.length} source{e.sources.length > 1 ? "s" : ""}
              </summary>
              {e.sources.map((s) => (
                <div class="src">
                  <a href={s.url} rel="noopener nofollow">
                    {s.name}
                  </a>{" "}
                  <span class="small muted">
                    {s.kind === "telegram" ? "Telegram" : "News"}
                    {s.official ? ", official" : ""} · {s.posted.slice(0, 10)}
                  </span>
                  <blockquote>“{s.quote}”</blockquote>
                </div>
              ))}
            </details>
          </li>
        );
      })}
    </ol>
  </section>
</Base>

<style>
  .lhead {
    margin-top: 40px;
  }
  .warn {
    color: var(--serious);
  }
  h1 {
    font-size: clamp(30px, 5vw, 44px);
    letter-spacing: -0.025em;
    margin: 10px 0;
  }
  .lede {
    font-size: 18px;
    color: var(--ink-2);
    max-width: 62ch;
    margin: 0 0 8px;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
    margin: 14px 0 18px;
  }
  .tile {
    padding: 14px 16px;
    border-style: dashed;
  }
  .tile-label {
    font-size: 13px;
    color: var(--ink-2);
  }
  .tile-value {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .tile-note {
    font-size: 12px;
    color: var(--ink-3);
  }
  .events {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .ev {
    padding: 12px 14px;
    border-style: dashed;
  }
  .ev-top {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }
  .ev-main {
    margin: 4px 0;
  }
  .rel {
    font: 600 11px var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-2);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .rel::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--serious);
  }
  .rel.official::before {
    background: var(--good);
  }
  .rel.corroborated::before {
    background: var(--warning);
  }
  .us {
    margin-left: 8px;
    padding: 1px 6px;
    border-radius: 999px;
    border: 1px solid var(--series-1);
    color: var(--series-1);
  }
  .src {
    margin-top: 8px;
  }
  .src blockquote {
    margin: 4px 0 0;
    font-size: 14px;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }
  .empty {
    padding: 16px;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }
</style>
