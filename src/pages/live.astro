---
import Base from "../layouts/Base.astro";
import LiveChart from "../components/LiveChart.astro";
import LiveEventCard from "../components/LiveEventCard.astro";
import { getLive } from "../lib/data";
import {
  IRAN_THEATERS,
  THREAT_LABEL,
  daysAgo,
  eventCount,
  filterEvents,
  latestTotals,
  totalCount,
  totals,
  whoseCounts,
  whoseTotal,
  withThe,
  type CountRange,
  type Theater,
} from "../lib/live";
import { BUILD_DATE } from "../lib/scenario";
import { fmt, formatDate } from "../lib/format";
import { href } from "../lib/site";

const live = getLive();
const today = BUILD_DATE;
const since30 = daysAgo(today, 29);
const groups = [
  {
    id: "iran",
    title: "Iran war theaters",
    note: "Persian Gulf, Israel and the Red Sea. These intercepts draw on the same U.S.-made interceptors the stockpile figures track.",
    events: filterEvents(live.events, "0000-00-00", IRAN_THEATERS),
    theaters: IRAN_THEATERS,
  },
  {
    id: "ukraine",
    title: "Ukraine",
    note: "Ukraine's Air Force posts a tally every morning. Most drones are downed by guns, jammers and interceptor drones, not by U.S. missiles.",
    events: filterEvents(live.events, "0000-00-00", ["ukraine"]),
    theaters: ["ukraine"] as readonly Theater[],
  },
];
const latest = live.events.slice(0, 40);
/** Days from `from` to `to`, inclusive. */
const span = (from: string, to: string) => Math.round((Date.parse(to) - Date.parse(from)) / 86_400_000) + 1;

const range = (c?: CountRange) =>
  !c ? "?" : Math.round(c.low) === Math.round(c.high) ? fmt(c.low) : `${fmt(c.low)}–${fmt(c.high)}`;
---

<Base
  title="Live intercept log"
  description="Drones and missiles reported shot down, from Telegram channels and news, updated several times a day. Unverified."
>
  <header class="lhead">
    <div class="label warn">Unverified · updated every 6 hours</div>
    <h1>Live intercept log</h1>
    <p class="lede">
      Drones and missiles reported shot down, read automatically from public Telegram channels and news headlines. It's
      current, but it isn't checked by a person, and early counts are often wrong. None of it feeds the stockpile
      estimates.
    </p>
    <p class="small muted">
      {live.updated ? (
        <>
          Last read {formatDate(live.updated.slice(0, 10))}, {live.updated.slice(11, 16)} UTC.
        </>
      ) : (
        "Not run yet."
      )}{" "}
      <a href={href("/methodology/#live")}>How this works</a> · U.S. drones shot down are on the{" "}
      <a href={href("/losses/")}>aircraft losses page</a>
    </p>
  </header>

  {groups.map((g) => {
    const e30 = filterEvents(g.events, since30);
    const t30 = totals(e30);
    // Launched only counts where a report gives it, so set it against what those same reports say was shot down.
    const fired30 = e30.filter((e) => eventCount(e, "launched"));
    const tFired = totals(fired30);
    const anyLaunched = fired30.length > 0;
    // Launch counts nearly always come from the defending government itself, which has reasons to shade them.
    const claimedBy = whoseCounts(fired30);
    // Events are newest first, so the last one is where this theater's log begins.
    const first = g.events.at(-1)?.date;
    const tAll = totals(g.events);
    const days = first ? Math.max(60, span(first, today)) : 60;
    // Running totals a government gives, the newest for each country and weapon. Shown apart:
    // adding one to the daily reports would count every earlier day twice.
    const running = latestTotals(live.totals, g.theaters).flatMap((t) => {
      const field = totalCount(t, "launched") ? "launched" : "intercepted";
      const c = totalCount(t, field);
      return c ? [{ t, field, c }] : [];
    });
    return (
      <section id={g.id}>
        <div class="section-head">
          <h2>{g.title}</h2>
        </div>
        <p class="muted small">{g.note}</p>
        <div class="tiles">
          <div class="card tile">
            <div class="tile-label">Reported shot down, last 30 days</div>
            <div class="tile-value">{range(t30.intercepted)}</div>
          </div>
          {anyLaunched ? (
            <div class="card tile">
              <div class="tile-label">Reported launched, last 30 days</div>
              <div class="tile-value">{range(tFired.launched)}</div>
              <div class="tile-note">
                {`Per ${claimedBy}, which can't be checked. ${range(tFired.intercepted)} of them shot down, in the ${fmt(fired30.length)} ${fired30.length === 1 ? "report" : "reports"} that say how many were launched.`}
              </div>
            </div>
          ) : (
            // Most statements here give only the number shot down, so a launched tile would always read empty.
            <div class="card tile">
              <div class="tile-label">Attacks reported, last 30 days</div>
              <div class="tile-value">{fmt(e30.length)}</div>
              <div class="tile-note">
                {`on ${fmt(new Set(e30.map((e) => e.date)).size)} ${new Set(e30.map((e) => e.date)).size === 1 ? "day" : "days"}; these reports don't say how many were fired`}
              </div>
            </div>
          )}
          <div class="card tile">
            <div class="tile-label">Reported shot down, all logged</div>
            <div class="tile-value">{range(tAll.intercepted)}</div>
            <div class="tile-note">
              {first ? `${fmt(tAll.events)} events since ${formatDate(first)}` : "nothing logged yet"}
            </div>
          </div>
        </div>
        {running.length > 0 && (
          <div class="running">
            <h3>Running totals governments give</h3>
            <p class="muted small">
              Counted since the start, so they aren't added to the daily reports above. They can't be checked either.
            </p>
            <ul>
              {running.map(({ t, field, c }) => (
                <li>
                  <strong>{range(c)}</strong>{" "}
                  {`${THREAT_LABEL[t.threat]} ${field === "launched" ? "fired at" : "shot down by"} ${withThe(t.defender)} since ${t.since}, as of ${formatDate(t.asOf)}.`}{" "}
                  <span class="muted">
                    Per <a href={t.sources[0].url}>{whoseTotal(t)}</a>.
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )}
        {g.events.length ? (
          <LiveChart events={g.events} today={today} days={days} label={g.title} />
        ) : (
          <p class="empty muted small">Nothing logged yet.</p>
        )}
      </section>
    );
  })}

  <section id="log">
    <div class="section-head">
      <h2>Latest reports</h2>
    </div>
    {latest.length === 0 && <p class="muted">The feed hasn't logged anything yet.</p>}
    <ol class="events">
      {latest.map((e) => (
        <LiveEventCard event={e} />
      ))}
    </ol>
    {live.events.length > 0 && (
      <p>
        <a href={href("/live/log/")}>
          Full log: {live.events.length > latest.length ? `all ${fmt(live.events.length)} events` : "everything logged"}
          , by month
        </a>
      </p>
    )}
  </section>
</Base>

<style>
  .lhead {
    margin-top: 40px;
  }
  .warn {
    color: var(--serious);
  }
  h1 {
    font-size: clamp(30px, 5vw, 44px);
    letter-spacing: -0.025em;
    margin: 10px 0;
  }
  .lede {
    font-size: 18px;
    color: var(--ink-2);
    max-width: 62ch;
    margin: 0 0 8px;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
    margin: 14px 0 18px;
  }
  .tile {
    padding: 14px 16px;
    border-style: dashed;
  }
  .tile-label {
    font-size: 13px;
    color: var(--ink-2);
  }
  .tile-value {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .tile-note {
    font-size: 12px;
    color: var(--ink-3);
  }
  .running {
    margin: 0 0 18px;
  }
  .running h3 {
    font-size: 16px;
    margin: 0 0 4px;
  }
  .running ul {
    margin: 6px 0 0;
    padding-left: 18px;
  }
  .events {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .empty {
    padding: 16px;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }
</style>
